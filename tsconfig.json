{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@nessa-ui/react/styles.css": [
        "./node_modules/@nessa-ui/react/src/styles.css"
      ],
      "@nessa-ui/react/app-shell": [
        "./node_modules/@nessa-ui/react/src/composites/app-shell"
      ],
      "@nessa-ui/react/theme.css": [
        "./node_modules/@nessa-ui/react/src/theme.css"
      ],
      "@nessa-ui/react/app.css": [
        "./node_modules/@nessa-ui/react/src/app.css"
      ],
      "@nessa-ui/react/lib/*": [
        "./node_modules/@nessa-ui/react/src/lib/*"
      ],
      "@nessa-ui/react/*": [
        "./node_modules/@nessa-ui/react/src/components/*"
      ],
      "@/components/*": [
        "./node_modules/@nessa-ui/react/src/components/*"
      ],
      "@/provider/*": [
        "./node_modules/@nessa-ui/react/src/provider/*"
      ],
      "@/lib/*": [
        "./node_modules/@nessa-ui/react/src/lib/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "verification/desktop/fixtures"
  ]
}
