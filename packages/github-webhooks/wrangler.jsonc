{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nessa-github-webhooks",
  "account_id": "572733d17410b5b1e34649e5f1b4cc3c",
  "build": { "command": "node scripts/prepare-cedar.mjs" },
  "rules": [{ "type": "Text", "globs": ["**/*.cedar"], "fallthrough": true }],
  "vars": { "RELAY_STAGE": "dev" },
  "durable_objects": {
    "bindings": [{ "name": "WAKE_ROOMS", "class_name": "RepositoryWakeRoom" }],
  },
  "migrations": [{ "tag": "relay-v1", "new_sqlite_classes": ["RepositoryWakeRoom"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "main": "src/composition/worker.ts",
  "compatibility_date": "2026-06-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nessa-github-webhooks",
      "database_id": "570dee24-f06a-41f5-a2b5-35de9660d794",
      "migrations_dir": "migrations",
    },
  ],
}
