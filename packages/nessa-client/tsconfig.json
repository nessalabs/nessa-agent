{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Only tests read the shared protocol tables; production source in this
    // package stays self-contained. See application/agent-budgets.ts.
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src", "examples/**/*.ts"]
}
