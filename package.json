{
  "name": "nessa-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "node scripts/ensure-nessa-ui.mjs",
    "dev": "node scripts/free-dev-port.mjs && vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "format": "prettier --write src scripts packages eslint.config.js prettier.config.js",
    "format:check": "prettier --check src scripts packages eslint.config.js prettier.config.js",
    "lint": "eslint src packages",
    "architecture": "node scripts/check-architecture.mjs",
    "protocol:generate": "node scripts/generate-protocol-types.mjs && node scripts/generate-product-protocol.mjs",
    "protocol:check": "node scripts/check-protocol.mjs && node scripts/check-product-protocol.mjs",
    "client:typecheck": "pnpm --dir packages/nessa-client typecheck",
    "client:test": "vitest run --config vitest.config.ts packages/nessa-client",
    "server:build": "cargo build -p nessa-server",
    "server:fmt:check": "cargo fmt -p nessa-server -- --check",
    "server:clippy": "cargo clippy -p nessa-server --all-targets -- -D warnings",
    "auth:test": "cargo test -p nessa-local-storage -p nessa-auth",
    "auth:clippy": "cargo clippy -p nessa-local-storage -p nessa-auth --all-targets -- -D warnings",
    "auth:fmt:check": "cargo fmt -p nessa-local-storage -p nessa-auth -- --check",
    "auth:cli": "tsx scripts/nessa-auth.mjs",
    "server:test": "cargo test -p nessa-server",
    "server:run": "cargo run -p nessa-server",
    "server:smoke": "tsx scripts/smoke-connect.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm architecture && pnpm protocol:check && pnpm client:docs:check && pnpm client:typecheck && pnpm typecheck && pnpm test && pnpm server:fmt:check && pnpm server:clippy && pnpm server:test && pnpm auth:fmt:check && pnpm auth:clippy && pnpm auth:test",
    "ui:types": "node scripts/ensure-nessa-ui.mjs --update",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "app:fast": "just release fast",
    "auth:e2e": "cargo build -p nessa-server && tsx scripts/smoke-auth.mjs",
    "client:docs": "pnpm protocol:generate && typedoc --options typedoc.client.json",
    "client:docs:json": "pnpm protocol:generate && typedoc --options typedoc.client.json --json docs/generated/client-api.json",
    "client:docs:check": "pnpm client:docs:json && node scripts/check-client-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@nessa-ui/react": "link:.vendor/nessa_ui/packages/react",
    "@nessa/client": "link:packages/nessa-client",
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.7",
    "ws": "^8.18.3"
  }
}
