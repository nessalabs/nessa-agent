{
  "name": "nessa-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "node scripts/ensure-nessa-ui.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "format": "prettier --write src scripts eslint.config.js prettier.config.js",
    "format:check": "prettier --check src scripts eslint.config.js prettier.config.js",
    "lint": "eslint src",
    "architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm architecture && pnpm typecheck && pnpm test",
    "ui:types": "node scripts/ensure-nessa-ui.mjs --update",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "app:fast": "CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 CARGO_PROFILE_RELEASE_OPT_LEVEL=1 CARGO_PROFILE_RELEASE_STRIP=false tauri build --bundles app"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@nessa-ui/react": "link:.vendor/nessa_ui/packages/react",
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  }
}
