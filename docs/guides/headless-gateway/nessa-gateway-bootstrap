#!/usr/bin/env bash
# Bootstrap helper installed at /opt/nessa/bin/nessa-gateway-bootstrap inside
# Cloud Box gateway VM images (ADR 1417, #1420, #1427). The gateway that made
# the box runs it over the VM's own connection; it prints one JSON line.
#
#   nessa-gateway-bootstrap create
#     Starts nessa-server (with the agents of the desktop runtime at
#     NESSA_RUNTIME_DIR, when the image has one) and the app tunnel if they
#     are not running, and
#     prints {"url":"wss://<host>","credential":"<token>"}.
#     url is the app tunnel's address: the box's product socket (`/session`),
#     the one a Desktop app connects to any gateway with. credential is the
#     box's own desktop surface credential (`nessa-panel`), which the server
#     provisions on first start with the grants the local Desktop holds; never
#     the owner token. Run again on the same VM, it prints the same credential.
#
#   nessa-gateway-bootstrap status
#     Starts both again after a wake and prints {"url":"wss://<host>"}. A quick
#     tunnel gets a new address each time cloudflared starts, so this is what
#     the box answers after every wake.
#
#   nessa-gateway-bootstrap busy
#     Prints {"busy":true|false} from the server's `server.activity`, which
#     counts every running conversation, background command and open terminal
#     on the gateway, whoever started it. Any failure to ask is busy (fail
#     closed, G5). A server this helper never started, or one that has exited,
#     has nothing running: idle.
#
# The helper starts both processes itself, detached, so it needs neither root
# nor any init system: a box that woke from an archive has neither running
# until the gateway's next `status` or `create` starts them.
#
# The gateway's identity is not printed: whoever connects learns it from the
# gateway's own handshake.
set -euo pipefail

if [[ -r /etc/nessa/gateway.env ]]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/nessa/gateway.env
  set +a
fi

cmd="${1:-status}"
runtime="${NESSA_RUNTIME_DIR:-}"
nessa="${NESSA_BIN:-${runtime:-/opt/nessa/bin}/nessa}"
cloudflared="${NESSA_CLOUDFLARED_BIN:-/opt/nessa/bin/cloudflared}"
box="${NESSA_BOX_DIR:-${HOME}/.nessa-box}"
export NESSA_STAGE="${NESSA_STAGE:-prod}"
export NESSA_DATA_DIR="${NESSA_DATA_DIR:-${box}/gateway}"
host="${NESSA_HOST:-127.0.0.1}"
port="${NESSA_PORT:-7420}"
export NESSA_HOST="${host}" NESSA_PORT="${port}"
metrics="${NESSA_APP_TUNNEL_METRICS:-127.0.0.1:20241}"
wait_seconds="${NESSA_BOOTSTRAP_WAIT_SECONDS:-90}"
# The stage's own directory: the data directory itself for prod, a
# directory named for the stage inside it otherwise.
namespace="${NESSA_DATA_DIR}"
[[ "${NESSA_STAGE}" == prod ]] || namespace="${NESSA_DATA_DIR}/${NESSA_STAGE}"
owner_token="${namespace}/owner.token"
desktop_token="${namespace}/auth/surfaces/nessa-panel.token"
passphrase="${box}/vault-passphrase"

pid_alive() {
  local file="${box}/$1.pid" pid
  [[ -r "${file}" ]] || return 1
  pid="$(cat "${file}")"
  [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null
}

healthy() {
  curl -fsS --max-time 5 "http://${host}:${port}/health" >/dev/null 2>&1
}

call() {
  "${nessa}" call "$1" --params '{}' --credential-file "${owner_token}"
}

# Directories, and the vault passphrase the server unlocks with: made once,
# on the box's first start, private to this user.
prepare() {
  umask 077
  mkdir -p "${box}" "${NESSA_DATA_DIR}"
  if [[ ! -s "${passphrase}" ]]; then
    head -c 48 /dev/urandom | base64 | tr -d '\n=' >"${passphrase}.new"
    printf '\n' >>"${passphrase}.new"
    mv "${passphrase}.new" "${passphrase}"
  fi
}

# Start `name` detached unless it already runs, its pid kept beside its log.
launch() {
  local name="$1"
  shift
  pid_alive "${name}" && return 0
  setsid "$@" >>"${box}/${name}.log" 2>&1 </dev/null &
  printf '%s\n' "$!" >"${box}/${name}.pid"
}

ensure_running() {
  prepare
  if ! healthy; then
    # With a prepared desktop runtime, the box runs the agents the app runs.
    local serve=(server --provision-local --vault-passphrase-file "${passphrase}")
    [[ -n "${runtime}" ]] && serve+=(--runtime "${runtime}")
    launch gateway "${nessa}" "${serve[@]}"
  fi
  launch app-tunnel "${cloudflared}" tunnel --no-autoupdate --metrics "${metrics}" \
    --url "http://${host}:${port}"
  for _ in $(seq 1 "${wait_seconds}"); do
    healthy && return 0
    pid_alive gateway || break
    sleep 1
  done
  echo "nessa-server did not become healthy on ${host}:${port}; see ${box}/gateway.log" >&2
  exit 1
}

# The app tunnel's address as the URL a client opens, once the tunnel serves
# the box's own /health. Cloudflare names a bare hostname, served over https;
# a stand-in on this machine (the stress check's) names a loopback origin,
# served over plain ws, which is all the gateway accepts without TLS.
app_url() {
  local hostname="" origin="" url=""
  for _ in $(seq 1 "${wait_seconds}"); do
    hostname="$(curl -fsS --max-time 5 "http://${metrics}/quicktunnel" 2>/dev/null \
      | jq -r '.hostname // empty' 2>/dev/null || true)"
    case "${hostname}" in
      "") origin="" ;;
      http://127.0.0.1:* | "http://[::1]:"*)
        origin="${hostname}"
        url="ws://${hostname#http://}"
        ;;
      *[/:]*) origin="" ;;
      *)
        origin="https://${hostname}"
        url="wss://${hostname}"
        ;;
    esac
    if [[ -n "${origin}" ]] \
      && curl -fsS --max-time 10 "${origin}/health" >/dev/null 2>&1; then
      printf '%s' "${url}"
      return 0
    fi
    sleep 1
  done
  echo "the app tunnel did not serve this gateway (hostname '${hostname}'); see ${box}/app-tunnel.log" >&2
  exit 1
}

case "${cmd}" in
  create)
    ensure_running
    url="$(app_url)"
    credential=""
    [[ -r "${desktop_token}" ]] && credential="$(tr -d '\r\n' <"${desktop_token}")"
    if [[ -z "${credential}" ]]; then
      echo "the server provisioned no desktop credential at ${desktop_token}" >&2
      exit 1
    fi
    jq -cn --arg url "${url}" --arg credential "${credential}" \
      '{url: $url, credential: $credential}'
    ;;
  status)
    ensure_running
    jq -cn --arg url "$(app_url)" '{url: $url}'
    ;;
  busy)
    if ! healthy; then
      if pid_alive gateway; then
        printf '{"busy":true}\n'
      else
        printf '{"busy":false}\n'
      fi
      exit 0
    fi
    if activity="$(call server.activity)" \
      && out="$(jq -c '{busy: (.busy != false)}' <<<"${activity}")"; then
      printf '%s\n' "${out}"
    else
      printf '{"busy":true}\n'
    fi
    ;;
  *)
    echo "usage: $0 {create|status|busy}" >&2
    exit 2
    ;;
esac
