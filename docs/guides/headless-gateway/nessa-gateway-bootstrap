#!/usr/bin/env bash
# Reference bootstrap helper installed at /opt/nessa/bin/nessa-gateway-bootstrap
# inside persistent cloud gateway VM images (ADR 1417 / #1420).
#
# Every fact it prints comes from the VM's own running nessa-server, asked
# through `nessa call` with the owner credential; it keeps no files of its own.
#
#   nessa-gateway-bootstrap create
#     Starts nessa-server if it is not running and prints one JSON line:
#     {"url":"wss://<host>","credential":"<token>"}
#     url is the web tunnel `server.reach` reports. credential is a new token
#     the server issues (`nessa auth token`), never the owner token itself.
#     Run again on the same VM, it issues another one.
#
#   nessa-gateway-bootstrap status
#     Starts nessa-server after a wake and prints {"url":"wss://<host>"}.
#
#   nessa-gateway-bootstrap busy
#     Prints {"busy":true|false}: true while any conversation is running or any
#     terminal is open. A list the server cannot give in full, or any failure
#     to ask, is busy (fail closed, G5). A server that is not running is idle
#     only where systemd says its unit is stopped.
#
# The gateway's identity is not printed: whoever connects learns it from the
# gateway's own handshake.
set -euo pipefail

cmd="${1:-status}"
nessa="${NESSA_BIN:-$(command -v nessa || printf '/opt/nessa/bin/nessa')}"
export NESSA_STAGE="${NESSA_STAGE:-prod}"
export NESSA_DATA_DIR="${NESSA_DATA_DIR:-/var/lib/nessa}"
host="${NESSA_HOST:-127.0.0.1}"
port="${NESSA_PORT:-18789}"
owner_token="${NESSA_OWNER_TOKEN_FILE:-${NESSA_DATA_DIR}/owner.token}"
wait_seconds="${NESSA_BOOTSTRAP_WAIT_SECONDS:-90}"
unit="nessa-server.service"

has_systemd() {
  command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]
}

healthy() {
  curl -fsS --max-time 5 "http://${host}:${port}/health" >/dev/null 2>&1
}

call() {
  local method="$1" params="${2:-}"
  [[ -n "${params}" ]] || params='{}'
  "${nessa}" call "${method}" --params "${params}" --credential-file "${owner_token}"
}

ensure_running() {
  if ! healthy && has_systemd; then
    systemctl start "${unit}"
  fi
  for _ in $(seq 1 "${wait_seconds}"); do
    healthy && return 0
    sleep 1
  done
  echo "nessa-server did not become healthy on ${host}:${port}" >&2
  exit 1
}

# The tunnel address the server reports, as the wss:// URL a client opens.
reach_url() {
  local tunnel=""
  for _ in $(seq 1 "${wait_seconds}"); do
    tunnel="$(call server.reach | jq -r '.tunnel // empty' 2>/dev/null || true)"
    [[ -n "${tunnel}" ]] && break
    sleep 1
  done
  if [[ "${tunnel}" != https://* ]]; then
    echo "server.reach reported no https:// tunnel (got '${tunnel}')" >&2
    exit 1
  fi
  printf 'wss://%s' "${tunnel#https://}"
}

case "${cmd}" in
  create)
    ensure_running
    url="$(reach_url)"
    credential="$("${nessa}" auth token --credential-file "${owner_token}" | tr -d '\r\n')"
    if [[ -z "${credential}" ]]; then
      echo "nessa auth token issued no credential" >&2
      exit 1
    fi
    jq -cn --arg url "${url}" --arg credential "${credential}" \
      '{url: $url, credential: $credential}'
    ;;
  status)
    ensure_running
    jq -cn --arg url "$(reach_url)" '{url: $url}'
    ;;
  busy)
    if ! healthy; then
      if unit_state="$(systemctl show --property=LoadState,ActiveState "${unit}" 2>/dev/null)" \
        && grep -Fxq 'LoadState=loaded' <<<"${unit_state}" \
        && grep -Fxq 'ActiveState=inactive' <<<"${unit_state}"; then
        printf '{"busy":false}\n'
      else
        printf '{"busy":true}\n'
      fi
      exit 0
    fi
    if open="$(call conversation.list '{"archived":false}')" \
      && archived="$(call conversation.list '{"archived":true}')" \
      && terminals="$(call terminal.list)" \
      && out="$(jq -cn --argjson open "${open}" --argjson archived "${archived}" \
        --argjson terminals "${terminals}" \
        '{busy: (
            ([$open, $archived] | any(.complete != true or (.conversations | type) != "array"))
            or (any(($open.conversations[], $archived.conversations[]); .running != false))
            or ($terminals.terminals | type != "array")
            or ($terminals.terminals | any(.state != "exited"))
          )}')"; then
      printf '%s\n' "${out}"
    else
      printf '{"busy":true}\n'
    fi
    ;;
  *)
    echo "usage: $0 {create|status|busy}" >&2
    exit 2
    ;;
esac
