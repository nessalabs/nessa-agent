#!/usr/bin/env bash
# Reference bootstrap helper installed at /opt/nessa/bin/nessa-gateway-bootstrap
# inside persistent cloud gateway VM images (ADR 1417 / #1420).
#
# Contract:
#   nessa-gateway-bootstrap create
#     Ensures headless nessa-server is running and prints a single JSON line:
#     {"gateway_id":"<id>","url":"wss://<host>","credential":"<one-time-token>"}
#
#   nessa-gateway-bootstrap status
#     Ensures headless nessa-server is running after VM wake and prints:
#     {"gateway_id":"<id>","url":"wss://<host>"}
#
#   nessa-gateway-bootstrap busy
#     Checks whether any turns or terminals are currently active and prints:
#     {"busy":true|false}
set -euo pipefail

cmd="${1:-status}"
state_dir="${NESSA_STATE_DIR:-/var/lib/nessa}"
gateway_id_file="${state_dir}/gateway-id"
url_file="${state_dir}/endpoint-url"
token_file="${state_dir}/owner.token"
active_work_file="${state_dir}/active-work.json"

ensure_running() {
  systemctl is-active --quiet nessa-server.service || systemctl start nessa-server.service

  for _ in $(seq 1 30); do
    if [[ -s "${gateway_id_file}" && -s "${url_file}" ]]; then
      break
    fi
    sleep 1
  done

  gateway_id="$(tr -d '\r\n' < "${gateway_id_file}")"
  url="$(tr -d '\r\n' < "${url_file}")"
}

case "${cmd}" in
  create)
    ensure_running
    credential="$(tr -d '\r\n' < "${token_file}")"
    jq -cn \
      --arg gateway_id "${gateway_id}" \
      --arg url "${url}" \
      --arg credential "${credential}" \
      '{gateway_id: $gateway_id, url: $url, credential: $credential}'
    ;;
  status)
    ensure_running
    jq -cn \
      --arg gateway_id "${gateway_id}" \
      --arg url "${url}" \
      '{gateway_id: $gateway_id, url: $url}'
    ;;
  busy)
    # If the gateway service is not running, no turns or terminals are active.
    if command -v systemctl >/dev/null 2>&1 && ! systemctl is-active --quiet nessa-server.service; then
      printf '{"busy":false}\n'
      exit 0
    fi
    # When running, require explicit authoritative evidence that busy == false;
    # missing, empty, or unreadable activity files fail closed as busy:true (G5).
    if [[ -s "${active_work_file}" ]] && out="$(jq -ce '{busy: (if .busy == false then false else true end)}' "${active_work_file}" 2>/dev/null)"; then
      printf '%s\n' "${out}"
    else
      printf '{"busy":true}\n'
    fi
    ;;
  *)
    echo "usage: $0 {create|status|busy}" >&2
    exit 2
    ;;
esac
