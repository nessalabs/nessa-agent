# Read by /opt/nessa/bin/nessa-gateway-bootstrap in a Cloud Box image
# (installed as /etc/nessa/gateway.env): where the image keeps the gateway
# runtime, and the ports its gateway and app tunnel use on loopback.
NESSA_STAGE=prod
NESSA_HOST=127.0.0.1
NESSA_PORT=7420
NESSA_APP_TUNNEL_METRICS=127.0.0.1:20241
NESSA_RUNTIME_DIR=/opt/nessa/runtime
