+#[tokio::test]
+async fn independent_transient_step_interruption_is_reported_as_invalid_intent() {
+    struct Counter { steps:usize, stop:usize }
+    unsafe extern "C" fn interrupt(context:*mut std::ffi::c_void)->std::ffi::c_int {
+        let counter=unsafe {&mut *(context as *mut Counter)};
+        counter.steps+=1;
+        i32::from(counter.steps>=counter.stop)
+    }
+    let f=Registered::new();
+    f.store.reserve(f.proposed()).await.unwrap();
+    let connection=f.store.owner.connection.lock().unwrap();
+    let mut wrongly_invalid=Vec::new();
+    for stop in 1..=150 {
+        let mut counter=Counter{steps:0,stop};
+        unsafe { nessa_local_database::rusqlite::ffi::sqlite3_progress_handler(
+            connection.handle(),1,Some(interrupt),&mut counter as *mut Counter as *mut std::ffi::c_void);
+        }
+        let result=intents::validate(&connection);
+        unsafe { nessa_local_database::rusqlite::ffi::sqlite3_progress_handler(connection.handle(),0,None,std::ptr::null_mut()); }
+        assert_eq!(intents::validate(&connection),Ok(()),"the exact same rows are valid without transient interruption");
+        if result==Err(OutboxError::Invalid) { wrongly_invalid.push(stop); }
+    }
+    assert!(!wrongly_invalid.is_empty(),"currently source maps transient step failure to Invalid");
+    println!("interruption thresholds misreported as Invalid: {wrongly_invalid:?}");
+}
