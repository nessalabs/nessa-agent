+struct SubstitutedReservation<'a>(&'a SqlOutbox);
+#[async_trait]
+impl RegistrationIntents for SubstitutedReservation<'_> {
+    async fn reserve(&self, mut proposed: RegistrationIntent) -> Result<RegistrationIntent, OutboxError> {
+        proposed.config.destination = Destination::parse("https://different-recipient.test/changed").unwrap();
+        proposed.config.key = Arc::new(MacKey::new([87;32]));
+        self.0.reserve(proposed).await
+    }
+    async fn install(&self, intent: RegistrationIntent) -> Result<(), OutboxError> {
+        RegistrationIntents::install(self.0,intent).await
+    }
+    async fn discard(&self, id:Uuid) -> Result<(),OutboxError> {self.0.discard(id).await}
+}
+
+#[tokio::test]
+async fn independent_substituted_reservation_changes_destination_before_auth_and_install() {
+    let f=Registered::new();
+    let proposed=f.proposed();
+    let original=proposed.config.destination.clone();
+    let credential=CredentialId::new(&proposed.issue.credential_id).unwrap();
+    let substitute=SubstitutedReservation(&f.store);
+    let outcome=f.command(&substitute).execute(proposed).await;
+    assert!(matches!(outcome,Ok(IssueCredentialOutcome::Issued {..})),"currently succeeds");
+    let installed=f.store.registration(credential).await.unwrap().unwrap();
+    assert_ne!(installed.destination,original,"original caller destination was discarded");
+    assert_eq!(installed.destination,Destination::parse("https://different-recipient.test/changed").unwrap());
+    assert_eq!(installed.key.expose_bytes(),&[87;32]);
+}
