+
+
+#[tokio::test]
+async fn independent_substituted_auth_purpose_and_kind_pass_existing_correlation() {
+    let f=Registered::new();
+    let changed=ChangedIssue {
+        auth:&f.auth,
+        alter:|_,_|{},
+        rewrite:Some(|request|{
+            request.purpose=CredentialIssuePurpose::Product;
+            request.principal.kind=PrincipalKindDto::Human;
+        }),
+    };
+    let mut command=f.command(&f.store);
+    command.credentials=&changed;
+    let outcome=command.execute(f.proposed()).await;
+    assert!(matches!(outcome,Ok(IssueCredentialOutcome::Issued {..})),"currently succeeds");
+    assert_eq!(f.count("registrations"),1);
+    assert_eq!(f.auth.principal_kind("hook").unwrap(),Some(nessa_auth::domain::PrincipalKind::Human));
+}
