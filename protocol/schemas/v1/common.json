{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nessa://protocol/v1/common.json",
  "$defs": {
    "ClientRole": {
      "type": "string",
      "enum": ["surface"]
    },
    "Scope": {
      "type": "string",
      "enum": ["server.read"]
    },
    "SurfaceKind": {
      "type": "string",
      "enum": ["panel", "web", "desktop", "cli"]
    },
    "RuntimeStatus": {
      "type": "string",
      "enum": ["ready", "starting", "unavailable", "error"]
    },
    "SurfaceInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instance"],
      "properties": {
        "kind": { "$ref": "#/$defs/SurfaceKind" },
        "instance": { "type": "string", "minLength": 1 }
      }
    },
    "ClientInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "platform"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "AuthToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "nonce"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "description": "Echo of connect.challenge nonce — binds this connect RPC to the open socket."
        }
      }
    },
    "GatewayError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details": {}
      }
    }
  }
}
