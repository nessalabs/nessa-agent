{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nessa://protocol/v1/frames.json",
  "$defs": {
    "ReqFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method", "params"],
      "properties": {
        "type": { "const": "req" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "params": {}
      }
    },
    "ResFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok"],
      "properties": {
        "type": { "const": "res" },
        "id": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "payload": {},
        "error": { "$ref": "common.json#/$defs/GatewayError" }
      }
    },
    "EventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event", "payload", "seq", "stateVersion"],
      "properties": {
        "type": { "const": "event" },
        "event": { "type": "string", "minLength": 1 },
        "payload": {},
        "seq": { "type": "integer", "minimum": 0 },
        "stateVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "Frame": {
      "oneOf": [
        { "$ref": "#/$defs/ReqFrame" },
        { "$ref": "#/$defs/ResFrame" },
        { "$ref": "#/$defs/EventFrame" }
      ]
    }
  }
}
