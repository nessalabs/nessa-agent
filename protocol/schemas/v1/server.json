{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nessa://protocol/v1/server.json",
  "$defs": {
    "HealthResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "runtimeStatus", "uptimeMs"],
      "properties": {
        "ok": { "type": "boolean" },
        "runtimeStatus": { "$ref": "common.json#/$defs/RuntimeStatus" },
        "uptimeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "PingParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce"],
      "properties": {
        "nonce": {
          "type": "string",
          "minLength": 1,
          "description": "Client-chosen value; the result must echo it."
        }
      }
    },
    "PingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "nonce"],
      "properties": {
        "ok": { "type": "boolean", "const": true },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "description": "Echo of PingParams.nonce."
        }
      }
    }
  }
}
