{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nessa://protocol/v1/conversation.json",
  "$defs": {
    "EchoParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "User draft text to echo back."
        }
      },
      "description": "Text input for the authorized conversation echo round trip."
    },
    "EchoResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Echo of EchoParams.text."
        }
      },
      "description": "Echoed input text; no model-generated reply is produced."
    }
  }
}
