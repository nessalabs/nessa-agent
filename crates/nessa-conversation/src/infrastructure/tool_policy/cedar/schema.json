{
  "Nessa": {
    "entityTypes": {
      "Owner": {},
      "Grant": {
        "shape": {
          "type": "Record",
          "attributes": {
            "toolPreset": {
              "type": "String",
              "required": true
            }
          },
          "additionalAttributes": false
        }
      },
      "Tool": {
        "shape": {
          "type": "Record",
          "attributes": {
            "name": {
              "type": "String",
              "required": true
            },
            "source": {
              "type": "String",
              "required": true
            }
          },
          "additionalAttributes": false
        }
      },
      "McpServer": {},
      "App": {
        "shape": {
          "type": "Record",
          "attributes": {
            "server": {
              "type": "Entity",
              "name": "McpServer",
              "required": true
            }
          },
          "additionalAttributes": false
        }
      },
      "McpTool": {
        "shape": {
          "type": "Record",
          "attributes": {
            "name": {
              "type": "String",
              "required": true
            },
            "server": {
              "type": "Entity",
              "name": "McpServer",
              "required": true
            },
            "visibleToApp": {
              "type": "Boolean",
              "required": true
            }
          },
          "additionalAttributes": false
        }
      }
    },
    "actions": {
      "tool.call": {
        "appliesTo": {
          "principalTypes": ["Owner", "Grant"],
          "resourceTypes": ["Tool"]
        }
      },
      "app.reach": {
        "appliesTo": {
          "principalTypes": ["App"],
          "resourceTypes": ["McpServer"]
        }
      },
      "app.callTool": {
        "appliesTo": {
          "principalTypes": ["App"],
          "resourceTypes": ["McpTool"]
        }
      },
      "app.sendUnreviewed": {
        "appliesTo": {
          "principalTypes": ["App"],
          "resourceTypes": ["McpServer"],
          "context": {
            "type": "Record",
            "attributes": {
              "approvalMode": {
                "type": "String",
                "required": true
              },
              "trustedApp": {
                "type": "Bool",
                "required": true
              }
            },
            "additionalAttributes": false
          }
        }
      }
    }
  }
}
