{
  "NessaDirectory": {
    "entityTypes": {
      "Grant": {
        "shape": {
          "type": "Record",
          "attributes": {
            "capabilities": {
              "type": "Set",
              "element": { "type": "String" },
              "required": true
            }
          },
          "additionalAttributes": false
        }
      },
      "Directory": {
        "shape": {
          "type": "Record",
          "attributes": {
            "id": { "type": "String", "required": true }
          },
          "additionalAttributes": false
        }
      },
      "Command": {
        "shape": {
          "type": "Record",
          "attributes": {
            "programName": { "type": "String", "required": true }
          },
          "additionalAttributes": false
        }
      }
    },
    "actions": {
      "directory.read": {
        "appliesTo": {
          "principalTypes": ["Grant"],
          "resourceTypes": ["Directory"],
          "context": {
            "type": "Record",
            "attributes": {
              "leave": { "type": "String", "required": true },
              "marker": { "type": "Boolean", "required": true }
            },
            "additionalAttributes": false
          }
        }
      },
      "directory.write": {
        "appliesTo": {
          "principalTypes": ["Grant"],
          "resourceTypes": ["Directory"],
          "context": {
            "type": "Record",
            "attributes": {
              "leave": { "type": "String", "required": true },
              "marker": { "type": "Boolean", "required": true }
            },
            "additionalAttributes": false
          }
        }
      },
      "directory.exec": {
        "appliesTo": {
          "principalTypes": ["Grant"],
          "resourceTypes": ["Directory"],
          "context": {
            "type": "Record",
            "attributes": {
              "leave": { "type": "String", "required": true },
              "marker": { "type": "Boolean", "required": true },
              "profile": { "type": "String", "required": true },
              "hidesMarker": { "type": "Boolean", "required": true },
              "rootLeave": { "type": "String", "required": true }
            },
            "additionalAttributes": false
          }
        }
      },
      "directory.command": {
        "appliesTo": {
          "principalTypes": ["Grant"],
          "resourceTypes": ["Command"],
          "context": {
            "type": "Record",
            "attributes": {
              "argv": { "type": "String", "required": true }
            },
            "additionalAttributes": false
          }
        }
      }
    }
  }
}
