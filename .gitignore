# --- Dependencies & vendor ---
node_modules/
.vendor/

# --- JavaScript / TypeScript build ---
dist/
coverage/
*.tsbuildinfo

# --- Rust (Cargo workspace: nessa-server + src-tauri) ---
# Match both a build directory and a symlink to a shared build directory.
/target
src-tauri/target/

# --- Tauri generated ---
src-tauri/gen/

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- OS ---
.DS_Store
Thumbs.db

# --- Editor / local tooling ---
.idea/
*.swp
*~

# Claude Code local worktrees (full repo copies for agent sessions)
.claude/worktrees/
# Per-machine dev-server config for the agent's browser preview. The skills
# beside it are shared and stay tracked.
.claude/launch.json

# --- Project-specific ---

# Local review notes and generated walkthroughs.
scratchpad/

# Rasterised icon intermediates: regenerate with scripts/render-icon.mjs
src-tauri/icons/nessa-avatar.png

# Screen recordings. They are how a rendering bug gets reported here, but they
# are megabytes of video that never diff, and this repository is public — a
# recording carries whatever else was on screen when it was taken.
*.mov

# Rebuild with pnpm client:docs or client:docs:json.
docs/generated/client-api/
docs/generated/client-api.json

# Generated bundled gateway and provider runtime
src-tauri/runtime/
