{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nessa",
  "identifier": "so.nessa.desktop",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev",
    "devUrl": "http://127.0.0.1:1438/desktop.html"
  },
  "app": {
    "windows": [
      {
        "label": "desktop",
        "url": "desktop.html",
        "title": "Nessa",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "skipTaskbar": false,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "theme": "Dark",
        "backgroundColor": "#111111"
      }
    ]
  }
}
