{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nessa",
  "mainBinaryName": "Nessa",
  "version": "0.1.0",
  "identifier": "so.nessa.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/desktop/prepare.mjs && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data:; img-src 'self' asset: http://asset.localhost blob: data: https:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:7420 http://127.0.0.1:7420 ws://127.0.0.1:7421 http://127.0.0.1:7421 https:; object-src 'none'; base-uri 'self'; frame-src nessa-sandbox: http://nessa-sandbox.localhost; form-action 'none'",
      "devCsp": null
    },
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": true,
        "url": "index.html",
        "title": "Nessa",
        "width": 420,
        "height": 900,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "desktop",
        "url": "desktop.html",
        "title": "Nessa",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        },
        "theme": "Dark",
        "backgroundColor": "#111111",
        "visible": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNjhCMDU1QUM2QzYxMTkKUldRWllXeXNWYkJvVC8xQWVVTlFKMVphNXJuR1ZvMm5HMEthZUE0di9PSFVlbFdydWR5Mk9lRm0K",
      "endpoints": [
        "https://github.com/nessalabs/nessa-agent/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
